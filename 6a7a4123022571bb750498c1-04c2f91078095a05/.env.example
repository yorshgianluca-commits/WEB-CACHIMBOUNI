# ============================================================
#  Supabase · variables de entorno para CachimboUNI
#  Copia este archivo como `.env` y pega tus valores reales.
#  En Netlify, define estas claves en:
#     Site settings → Environment variables
#  Recuerda: deben empezar por VITE_ para que Vite las incluya
#  en el bundle del frontend.
# ============================================================

# URL del proyecto (Project URL) — ej. https://xxxx.supabase.co
VITE_SUPABASE_URL=

# API anon/public key (la "anon public" — segura para el frontend)
VITE_SUPABASE_ANON_KEY=
